DB_HOST=localhost
DB_PORT=5432
DB_NAME=library
DB_USER=library_user
DB_PASSWORD=change-me

CORS_ORIGINS=*
PORT=5001

# Mismo valor en TODOS los servicios; mínimo 32 caracteres; alias SECRET_KEY; el servicio no arranca con el valor de ejemplo
JWT_SECRET_KEY=change-me-same-value-in-every-service
# true = imprime el token Bearer en el log de cada escritura (evidencia para revision)
LOG_TOKENS=true

REDIS_URL=redis://:change-me-redis-password@localhost:6379/0
REDIS_TIMEOUT=2
BOOKS_CACHE_TTL=60

# Depurador de Werkzeug (expone trazas y una consola): solo true en desarrollo local
SOAP_DEBUG=false
