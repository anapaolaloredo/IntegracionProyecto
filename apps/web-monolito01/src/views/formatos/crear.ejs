<%- include('../partials/header', { titulo: 'Nuevo ' + etiqueta }) %>
  <h1>Nuevo <%= etiqueta %></h1>
  <% if (error) { %><div class="mensaje-error"><%= error %></div><% } %>
  <div class="tarjeta">
    <form class="formulario" method="POST" action="/<%= vista %>">
      <div>
        <label for="<%= campoNombre %>">Nombre</label>
        <input type="text" id="<%= campoNombre %>" name="<%= campoNombre %>" value="<%= valores[campoNombre] || '' %>" required>
      </div>
      <button type="submit" class="btn">Guardar</button>
    </form>
  </div>
<%- include('../partials/footer') %>
