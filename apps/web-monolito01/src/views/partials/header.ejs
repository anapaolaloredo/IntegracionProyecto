<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof titulo !== 'undefined' ? titulo + ' · Libreria en linea' : 'Libreria en linea' %></title>
  <link rel="stylesheet" href="<%= basePath %>/css/estilos.css">
</head>
<body>
  <nav class="barra-nav">
    <div>
      <span class="marca">📚 Libreria en linea</span>
      <% if (usuarioActual) { %>
        <a href="<%= basePath %>/libros">Catalogo</a>
        <a href="<%= basePath %>/autores">Autores</a>
        <a href="<%= basePath %>/generos">Generos</a>
        <a href="<%= basePath %>/formatos">Formatos</a>
        <a href="<%= basePath %>/conceptos">Conceptos</a>
        <% if (usuarioActual.rol === 'admin') { %>
          <a href="<%= basePath %>/usuarios">Usuarios</a>
        <% } %>
      <% } %>
    </div>
    <div>
      <% if (usuarioActual) { %>
        <span>👤 <%= usuarioActual.nombre_usuario %> <span class="etiqueta-rol"><%= usuarioActual.rol %></span></span>
        <form method="POST" action="<%= basePath %>/auth/logout" style="display:inline">
          <button type="submit" class="enlace">Cerrar sesion</button>
        </form>
      <% } else { %>
        <a href="<%= basePath %>/auth/login">Iniciar sesion</a>
        <a href="<%= basePath %>/auth/registro">Registrarse</a>
      <% } %>
    </div>
  </nav>
  <main class="contenedor">
