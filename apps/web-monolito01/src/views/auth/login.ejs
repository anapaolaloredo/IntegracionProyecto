<%- include('../partials/header', { titulo: 'Iniciar sesion' }) %>
  <div class="tarjeta" style="max-width:420px;margin:2rem auto;">
    <h1>Iniciar sesion</h1>
    <% if (error) { %><div class="mensaje-error"><%= error %></div><% } %>
    <form class="formulario" method="POST" action="/auth/login">
      <div>
        <label for="correo">Correo</label>
        <input type="email" id="correo" name="correo" required>
      </div>
      <div>
        <label for="contrasena">Contrasena</label>
        <input type="password" id="contrasena" name="contrasena" required>
      </div>
      <button type="submit" class="btn">Entrar</button>
    </form>
    <p style="margin-top:1rem;">¿No tienes cuenta? <a href="/auth/registro">Registrate aqui</a></p>
  </div>
<%- include('../partials/footer') %>
