# Copiar como .env y llenar con valores reales. NUNCA subir el .env real
# al repositorio ni al .tar.gz de entrega (ver docs/SECURITY_REVIEW.md).

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=library
PGUSER=library_user
PGPASSWORD=

# Sesion (usar una cadena larga y aleatoria en produccion)
SESSION_SECRET=

# Prefijo de despliegue detras del reverse proxy (vacio para probar en
# local sin prefijo; ver docs/GCP_COMMANDS.md seccion 7.1)
BASE_PATH=/library

# Puerto en el que escucha Node (siempre en 127.0.0.1, nunca expuesto
# directo a internet; ver docs/GCP_COMMANDS.md)
PORT=3000

# development | production (en production no se exponen mensajes de
# error internos al usuario final, ver app.js)
NODE_ENV=development
